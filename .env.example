# ==============================================================================
# PLC FISHBOWL ENVIRONMENT CONFIGURATION
# ==============================================================================

# OPTION 1: Obfuscated Community Key (Recommended for GitHub Pages)
# Run `node -e "const { obfuscateKey } = require('./lib/keyManager'); console.log(obfuscateKey('AIzaSy...'))"`
# or generate it in browser console using the obfuscateKey function.
# NEXT_PUBLIC_ENCODED_GEMINI_KEY=...

# OPTION 2: Direct Public Key (Unencoded)
# NEXT_PUBLIC_GEMINI_KEY=AIzaSy...

# NOTE: If neither is set in the build environment, users will simply be prompted
# on the Setup page to enter their own Gemini API key (stored in local browser memory).
